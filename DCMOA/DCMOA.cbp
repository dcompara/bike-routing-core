				<Option type="1" />
				<Option compiler="gcc" />
				<Option parameters=".\bin\Release\roadhog --alg NWMOA --input .\maps\graph_Paris_south_2_objectives.xy  --start 14066      --goal 13953  --path --constraint 10" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add directory="domains" />
