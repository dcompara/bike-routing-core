				<Option type="1" />
				<Option compiler="gcc" />
				<Option parameters=".\bin\Release\roadhog --alg DCMOA       --input .\maps\graph_Paris_south_2_objectives.xy  --start 14066      --goal 13953  --path --constraint 10" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/DCMOA" prefix_auto="1" extension_auto="1" />
